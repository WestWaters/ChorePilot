<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for `chorepilot run`. `chorepilot service install` writes this with the
     right paths; by hand: edit the paths, copy to ~/Library/LaunchAgents/, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.chorepilot.run.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chorepilot.run</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/chorepilot</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/chorepilot.log</string>
  <key>StandardErrorPath</key><string>/tmp/chorepilot.log</string>
</dict>
</plist>
